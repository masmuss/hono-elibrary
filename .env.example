# ─────────────────────────────
# 🔧 Environment Configuration
# ─────────────────────────────
NODE_ENV=development

# ─────────────────────────────
# 🗄️ PostgreSQL Database Configuration
# ─────────────────────────────
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# ─────────────────────────────
# 🧠 Redis Configuration
# ─────────────────────────────
REDIS_URL=

# ─────────────────────────────
# 📧 SMTP / Email Configuration
# ─────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─────────────────────────────
# 🧪 Artillery
# ─────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
MEMBER_USERNAME=
MEMBER_PASSWORD=
LIBRARIAN_USERNAME=
LIBRARIAN_PASSWORD=

# ─────────────────────────────
# 🔐 JWT / Authentication Configuration
# ─────────────────────────────
JWT_SECRET=
